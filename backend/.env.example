PORT=5005
NODE_ENV=development

# ─── Database ─────────────────────────────────────────────────────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your_supabase_anon_or_service_role_key
DATABASE_URL=postgres://postgres:your_password@db.your-project.supabase.co:5432/postgres

DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=postgres

# ─── Auth ─────────────────────────────────────────────────────────────────────
JWT_SECRET=change_this_to_a_long_random_secret
JWT_EXPIRES=7d

# ─── Email — SMTP Configuration (Gmail, Brevo, SendGrid, custom) ─────────────
#
# SETUP STEPS (Gmail):
#   1. Your Gmail account must have 2-Step Verification ON: https://myaccount.google.com/security
#   2. Create an App Password: https://myaccount.google.com/apppasswords
#   3. Select App: "Other" -> Name it "Smart Lab"
#   4. Paste the 16-character App Password below (spaces are automatically stripped)
#
GMAIL_USER=your_gmail@gmail.com
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx
SENDER_NAME=PESITM Smart Lab

# SMTP Configuration (optional custom host/port — defaults to smtp.gmail.com:465 with auto-fallback to 587)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your_gmail@gmail.com
SMTP_PASS=xxxx xxxx xxxx xxxx
MAIL_FROM="PESITM Smart Lab <your_gmail@gmail.com>"

# ─── Twilio SMS (optional) ────────────────────────────────────────────────────
TWILIO_SID=your_sid
TWILIO_AUTH=your_auth
TWILIO_FROM=+1XXXXXXXXXX

# ─── Client ───────────────────────────────────────────────────────────────────
CLIENT_URL=http://localhost:5173

# ─── AI (Gemini) ──────────────────────────────────────────────────────────────
GEMINI_API_KEY=your_gemini_api_key
AI_API_KEY=your_gemini_api_key
